# Kanam Forge - environment variables
# Copy to adorable/.env.local and fill in. Alternatively, set the API key from
# the in-app settings dialog (ApiKeyGate) which stores it in a cookie.
#
# NOTE: Next.js runs from the adorable/ workspace, so the .env.local must live
# in adorable/ (not the repo root). See adorable/.env.local.

# --- LLM Provider ---
# Choose which provider to use: "openai" (default), "anthropic", or "ollama" (local)
LLM_PROVIDER=ollama

# Ollama local (used if LLM_PROVIDER=ollama)
# NOTE: the base URL must include the /api suffix for ollama-ai-provider-v2
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=deepseek-v4-flash:cloud

# OpenAI API key (used if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic API key (used if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# --- Local Docker sandbox (Fase 1) ---
# Directory where project volumes are stored on the host.
# Leave unset to use the default (~/.kanam-forge/projects). Do NOT use a
# literal "~" here - Node does not expand it and existsSync will fail.
# KANAM_FORGE_DATA_DIR=/absolute/path/to/projects

# Docker socket or API endpoint for the container orchestrator
DOCKER_HOST=unix:///var/run/docker.sock
